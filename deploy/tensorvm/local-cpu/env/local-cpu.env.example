TENSORVM_DATA_DIR=/var/lib/tensorvm
TENSORVM_AUTH_TOKEN=local-cpu-testnet-token
TENSORVM_MINER_STAKE=100
TENSORVM_VALIDATOR_STAKE=10000
TENSORVM_DEVICE=cpu
TENSORVM_BOOTSTRAP_PEER_ID=12D3KooWS2oXcVvmNNWTiUzwDWJavRHQmewe1NDfJB7SxP43jA7s
TENSORVM_BOOTSTRAP_ADDRESS=/dns4/miner-00/tcp/4001
TENSORVM_SEED_LOCAL_TESTNET=true
TENSORVM_LOCAL_CPU_BLOCK_INTERVAL_MS=1000
TENSORVM_LOCAL_CPU_SYNTHETIC_JOB_PRODUCER=false
TENSORVM_LOCAL_CPU_VALIDATOR_BLOCK_PROPOSER=false
TENSORVM_LOCAL_CPU_VALIDATOR_BLOCK_PROPOSER_DELAY_BLOCKS=0
TENSORVM_LOCAL_CPU_PROPOSER_COOLDOWN_BLOCKS=2
# Rely on Kademlia content routing (provider records) for tensor availability;
# the interim gossip-relay is off. Set to true to re-enable the belt-and-suspenders.
TENSORVM_LOCAL_CPU_INTERIM_TENSOR_GOSSIP=false
TENSORVM_RANDOMNESS_BEACON_MODE=local_deterministic
TENSORVM_RANDOMNESS_BEACON_SOURCE_ID=local_drand_fixture_v1
TENSORVM_RANDOMNESS_BEACON_ROUND=1000
TENSORVM_PUBLIC_EVIDENCE_FULL_SPEC=false
TENSORVM_INDEPENDENTLY_CHECKABLE=false
